# Copia este archivo como .env.local y llena tus valores.
#   macOS / Linux:  cp .env.example .env.local
#   Windows:        copy .env.example .env.local
# .env.local está en .gitignore: tus llaves NUNCA se suben a GitHub.

# --- NVIDIA (build.nvidia.com → tu perfil → API Keys). Empieza con nvapi-
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxx
# Modelo para el ejercicio de Node (puedes cambiarlo por otro del catálogo)
NVIDIA_MODEL=

# --- Supabase (Project Settings → API / Connect)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Usa la "publishable key" (sb_publishable_...). Si tu proyecto solo muestra "anon key", pégala aquí también.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
